[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://addons/hearth_workbench/workbench_quick_find.gd" id="1"]

[node name="QuickFind" type="PopupPanel"]
script = ExtResource("1")

[node name="Inset" type="MarginContainer" parent="."]
unique_name_in_owner = true
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Column" type="VBoxContainer" parent="Inset"]

[node name="Context" type="Label" parent="Inset/Column"]
unique_name_in_owner = true
text_overrun_behavior = 3

[node name="Query" type="LineEdit" parent="Inset/Column"]
unique_name_in_owner = true
placeholder_text = "Find a record, setting, or action"
clear_button_enabled = true

[node name="Results" type="Tree" parent="Inset/Column"]
unique_name_in_owner = true
size_flags_vertical = 3
hide_root = true
columns = 2
focus_mode = 0

[node name="Hint" type="Label" parent="Inset/Column"]
unique_name_in_owner = true
text = "↑ ↓  Select     Enter  Open     Esc  Back"
