[gd_scene format=3]

[node name="WorkbenchLayout" type="PanelContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Stack" type="VBoxContainer" parent="."]

[node name="BarInset" type="MarginContainer" parent="Stack"]
unique_name_in_owner = true

[node name="TopBar" type="HBoxContainer" parent="Stack/BarInset"]
unique_name_in_owner = true

[node name="BrowserToggle" type="Button" parent="Stack/BarInset/TopBar"]
unique_name_in_owner = true
text = "Browse"
toggle_mode = true
button_pressed = true
tooltip_text = "Show or hide the sections and records. Ctrl+B"

[node name="Breadcrumb" type="Label" parent="Stack/BarInset/TopBar"]
unique_name_in_owner = true
size_flags_horizontal = 3
text_overrun_behavior = 3

[node name="CommandButton" type="Button" parent="Stack/BarInset/TopBar"]
unique_name_in_owner = true
text = "Quick find   Ctrl+K"
tooltip_text = "Find a section, record, setting, or action anywhere in Workbench."

[node name="BackButton" type="Button" parent="Stack/BarInset/TopBar"]
unique_name_in_owner = true
