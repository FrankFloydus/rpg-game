[gd_scene format=3]

[ext_resource type="Theme" path="res://ui/hearth_gear_theme.tres" id="theme"]

[node name="StatRow" type="HBoxContainer"]
theme = ExtResource("theme")

[node name="Caption" type="Label" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 13
text = "Attack Speed"
size_flags_horizontal = 3
autowrap_mode = 3
theme_override_colors/font_color = Color(0.69, 0.71, 0.75, 1)

[node name="Value" type="Label" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 13
text = "—"
custom_minimum_size = Vector2(44, 0)
theme_type_variation = &"GearValue"
horizontal_alignment = 2
