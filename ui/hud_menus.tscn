[gd_scene format=3]

[ext_resource type="Theme" path="res://ui/hearth_gear_theme.tres" id="1_theme"]
[ext_resource type="PackedScene" path="res://ui/hud_menu_button.tscn" id="2_action"]

[sub_resource type="StyleBoxFlat" id="Frame"]
content_margin_left = 25.0
content_margin_top = 22.0
content_margin_right = 25.0
content_margin_bottom = 22.0
bg_color = Color(0.0431, 0.0471, 0.0549, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.3333, 0.3569, 0.3843, 1)

[node name="Overlay" type="ColorRect"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_theme")
color = Color(0.021, 0.023, 0.026, 0.77)

[node name="Center" type="CenterContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Frame" type="PanelContainer" parent="Center"]
layout_mode = 2
theme_override_styles/panel = SubResource("Frame")

[node name="Contents" type="VBoxContainer" parent="Center/Frame"]
layout_mode = 2
theme_override_constants/separation = 13

